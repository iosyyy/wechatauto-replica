+@pytest.mark.asyncio
+@pytest.mark.parametrize('send_response', [{'Code': 200}, {'Code': 409}])
+async def test_ack_waits_for_real_pipeline_and_successful_send(harness, send_response):
+    h = harness
+    h.adapter.bot.send_text_message.return_value = send_response
+    delivery = asyncio.create_task(h.adapter.ws_message(native_event()))
+    query = await queued(h, delivery)
+    entered, release = asyncio.Event(), asyncio.Event()
+    configure_stages(h, query, entered, release)
+    processing = asyncio.create_task(h.runtime._process_query(query))
+    await asyncio.wait_for(entered.wait(), 1)
+    assert h.adapter._ws_app.sent == []
+    assert not delivery.done()
+    release.set()
+    await asyncio.wait_for(processing, 1)
+    if send_response['Code'] == 200:
+        await asyncio.wait_for(delivery, 1)
+        assert h.adapter._ws_app.sent == [{'type': 'ack', 'event_id': 'event-1'}]
+        assert query.variables['_native_delivery_status'] == 'completed'
+        assert query.message_event.source_platform_object['_bridge_reply_sequence'] == 1
+        assert copy.copy(query).message_event.source_platform_object is query.message_event.source_platform_object
+    else:
+        with pytest.raises(RuntimeError):
+            await asyncio.wait_for(delivery, 1)
+        assert h.adapter._ws_app.sent == []
+        assert query.variables['_native_delivery_status'] == 'failed'
+    assert h.pool.queries == []
+    h.app.msg_aggregator.add_message.assert_not_awaited()
