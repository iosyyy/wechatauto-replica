+class Socket:
+    def __init__(self):
+        self.sent = []
+        self.threads = []
+        self.closed = False
+
+    def send(self, value):
+        self.threads.append(threading.get_ident())
+        self.sent.append(json.loads(value))
+
+    def close(self, **kwargs):
+        self.closed = True
