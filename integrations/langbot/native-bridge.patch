+    adapter._schedule_ws_message(native_event(), origin)
+    adapter._ws_app = Socket()
+    for _ in range(100):
+        if origin.sent and not adapter._callback_futures:
+            break
+        await asyncio.sleep(0.01)
+    assert origin.sent == [{'type': 'ack', 'event_id': 'event-1'}]
+    assert not adapter._callback_futures
+
+
