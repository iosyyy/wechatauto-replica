+@pytest.mark.asyncio
+async def test_cancellation_during_bootstrap_backoff_propagates_immediately(startup, monkeypatch):
+    startup.client.get_login_status.side_effect = requests.Timeout('read timed out')
+    monkeypatch.setattr(type(startup.adapter), '_BOOTSTRAP_RETRY_DELAYS', (5, 5, 5))
+    task = asyncio.create_task(startup.adapter.run_async())
+    try:
+        while startup.client.get_login_status.call_count == 0:
+            await asyncio.sleep(0)
+        await asyncio.sleep(0.01)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await asyncio.wait_for(task, 0.2)
+        assert startup.client.get_login_status.call_count == 1
+        startup.socket_factory.assert_not_called()
+    finally:
+        if not task.done():
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
