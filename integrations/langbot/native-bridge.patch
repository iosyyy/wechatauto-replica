+async def queued(harness, delivery):
+    for _ in range(100):
+        if harness.pool.queries or delivery.done():
+            break
+        await asyncio.sleep(0.001)
+    assert not delivery.done(), 'native ingress returned after enqueue rather than real completion'
+    assert len(harness.pool.queries) == 1
+    return harness.pool.queries[0]
+
+
+def configure_stages(harness, query, entered, release):
+    class Provider:
+        async def process(self, query, stage_name):
+            entered.set()
+            await release.wait()
+            query.resp_message_chain = [text_chain('generated response')]
+            query.resp_messages = []
+            return StageProcessResult(result_type=ResultType.CONTINUE, new_query=query)
+
+    query.pipeline_config = {
+        'output': {'force-delay': {'min': 0, 'max': 0}, 'misc': {'at-sender': False, 'quote-origin': False}}
+    }
+    harness.runtime.stage_containers = [
+        SimpleNamespace(inst_name='Provider', inst=Provider()),
+        SimpleNamespace(inst_name='SendResponseBackStage', inst=SendResponseBackStage(harness.app)),
+    ]
+
