+"""Read-only bootstrap failures must recover before WebSocket startup."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import requests
+
+from tests.unit_tests.platform.test_wechatpad_bridge_delivery import DummyLogger, wechatpad
+
+
+PROFILE = {'Data': {'userInfo': {'nickName': {'str': 'synthetic bot'}, 'userName': {'str': 'wxid_self'}}}}
+
+
+def wrapped_transport_error():
+    try:
+        raise requests.ConnectionError('https://example.invalid?key=private-token private body')
+    except requests.ConnectionError:
+        try:
+            raise RuntimeError('SDK wrapper includes a private token')
+        except RuntimeError as error:
+            return error
+
+
+@pytest.fixture
+def startup(monkeypatch):
+    adapter = wechatpad.WeChatPadAdapter(
+        {
+            'wechatpad_url': 'https://example.invalid',
+            'wechatpad_ws': 'wss://example.invalid',
+            'admin_key': 'synthetic-admin',
+            'token': 'private-token',
+            'wxid': 'wxid_self',
+        },
+        DummyLogger(),
+    )
+    client = SimpleNamespace(get_login_status=Mock(return_value={'Code': 200}), get_profile=Mock(return_value=PROFILE))
+    client_factory = Mock(return_value=client)
+    monkeypatch.setattr(wechatpad, 'WeChatPadClient', client_factory)
+    monkeypatch.setattr(type(adapter), '_BOOTSTRAP_RETRY_DELAYS', (0.001, 0.002, 0.003), raising=False)
+    post = Mock(side_effect=AssertionError('bootstrap reads must not generate a new token'))
+    monkeypatch.setattr(wechatpad.requests, 'post', post)
+    socket = SimpleNamespace(run_forever=Mock(side_effect=lambda **kwargs: adapter._stop_event.set()))
+    socket_factory = Mock(return_value=socket)
+    monkeypatch.setattr(wechatpad.websocket, 'WebSocketApp', socket_factory)
+
+    def inline_thread(*, target, **kwargs):
+        return SimpleNamespace(start=target, is_alive=lambda: False)
+
+    monkeypatch.setattr(wechatpad, 'threading', SimpleNamespace(Thread=inline_thread))
+    return SimpleNamespace(
+        adapter=adapter, client=client, factory=client_factory, socket_factory=socket_factory, post=post
+    )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('method', ['get_login_status', 'get_profile'])
+async def test_transient_bootstrap_reads_recover_and_reach_websocket_setup(startup, method, caplog):
+    h = startup
+    read = getattr(h.client, method)
+    read.side_effect = [
+        wrapped_transport_error(),
+        requests.ConnectionError('Connection refused'),
+        {'Code': 200} if method == 'get_login_status' else PROFILE,
+    ]
+    with caplog.at_level(logging.WARNING, logger=wechatpad.__name__):
+        await asyncio.wait_for(h.adapter.run_async(), 1)
+    assert read.call_count == 3
+    h.socket_factory.assert_called_once()
+    h.post.assert_not_called()
+    assert h.adapter.bot_account_id == 'synthetic bot'
+    assert h.adapter.config['wxid'] == 'wxid_self'
+    assert len(caplog.records) == 2
+    for private in ('example.invalid', 'private-token', 'private body', 'SDK wrapper'):
+        assert private not in caplog.text
+
+
+@pytest.mark.asyncio
+async def test_explicit_wrapped_timeout_cause_recovers_before_websocket_setup(startup):
+    error = RuntimeError('SDK timeout wrapper')
+    error.__cause__ = requests.Timeout('provider request timed out')
+    startup.client.get_profile.side_effect = [error, PROFILE]
+    await asyncio.wait_for(startup.adapter.run_async(), 1)
+    assert startup.client.get_profile.call_count == 2
+    startup.socket_factory.assert_called_once()
+    startup.post.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('method', ['get_login_status', 'get_profile'])
+@pytest.mark.parametrize('error', [RuntimeError('configuration error'), json.JSONDecodeError('bad JSON', 'x', 0)])
+async def test_nontransport_read_errors_do_not_retry_or_start_websocket(startup, method, error):
+    read = getattr(startup.client, method)
+    read.side_effect = error
+    with pytest.raises(type(error)):
+        await startup.adapter.run_async()
+    assert read.call_count == 1
+    startup.socket_factory.assert_not_called()
+    startup.post.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('error', [json.JSONDecodeError('bad JSON', 'x', 0), KeyError('Data'), TypeError('schema')])
+async def test_wrapped_schema_error_with_old_transport_context_is_not_retried(startup, error):
+    error.__context__ = requests.ConnectionError('previous request')
+    wrapped = RuntimeError('SDK parse wrapper')
+    wrapped.__cause__ = error
